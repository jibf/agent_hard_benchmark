# AgentHard Benchmark Suite Environment Configuration
# Copy this file to .env and fill in your API credentials

# ========================
# REQUIRED CONFIGURATION
# ========================

# Main API Configuration (Required)
API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1

# RAPID_API Configuration (Required for some benchmarks)
# Used by: CFBench, ToolSandbox
RAPID_API_KEY=your_rapid_api_key_here

# ========================
# OPTIONAL CONFIGURATION
# ========================

# User Model Configuration (Optional - for benchmarks that need user simulation)
# Used by: TauBench, Tau2Bench
# Can also be set via --user-model command line argument
USER_MODEL=openai/gpt-4o-20240806

# ========================
# PROVIDER EXAMPLES
# ========================

# Alternative provider configurations:
# For OpenAI: BASE_URL=https://api.openai.com/v1
# For Anthropic: BASE_URL=https://api.anthropic.com
# For Google: BASE_URL=https://generativelanguage.googleapis.com/v1
# For local vLLM: BASE_URL=http://localhost:8000/v1
# For custom endpoint: BASE_URL=your_custom_endpoint

# ========================
# ADVANCED CONFIGURATION
# ========================

# Provider-specific API keys (Optional - only if different from main API_KEY)
# These will be automatically set by the runner using the main API_KEY
# Uncomment only if you need different keys for specific providers

OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=your_openai_base_url
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key
# MISTRAL_API_KEY=your_mistral_key

# Additional provider-specific keys
# GPT_API_KEY=your_gpt_api_key         # Used by some benchmarks
# GPT_AGENT_API_KEY=your_agent_key     # Used by ACEBench
# DEEPSEEK_API_KEY=your_deepseek_key   # Used by ACEBench
# QWEN_API_KEY=your_qwen_key          # Used by ACEBench

# ========================
# BENCHMARK-SPECIFIC NOTES
# ========================

# DrafterBench: Uses API_KEY + BASE_URL
# ToolSandbox: Uses API_KEY + RAPID_API_KEY (hardcoded model names)
# NexusBench: Uses API_KEY + BASE_URL via command line args
# CFBench: Uses API_KEY + RAPID_API_KEY via environment
# MultiChallenge: Uses API_KEY + BASE_URL
# ACEBench: Uses multiple provider keys
# TauBench: Uses API_KEY + USER_MODEL + specific provider keys
# Tau2Bench: Uses API_KEY + USER_MODEL
# BFCL: Uses API_KEY + BASE_URL