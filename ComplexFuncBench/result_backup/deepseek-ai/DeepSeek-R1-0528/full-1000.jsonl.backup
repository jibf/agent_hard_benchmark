 and transportation while you’re abroad (international flight bookings only)"], "finePrint": ["This plan is issued by Cover Genius Insurance Services, LLC, and includes insurance by US Fire and non-insurance services by On Call International. By selecting this coverage, I agree that I have read and agree to the <a href='https://www.xcover.com/en-us/pds/7UE7J-7ALTS-INS' id='insurance_terms_link' target='_blank' rel='noopener noreferrer' >Plan Terms & Disclosures</a>. Coverage is not available for travellers residing in Hawaii, Kansas, New York, or Wyoming."]}, "forceForAllTravellers": true, "isPerTraveller": true, "version": 0, "recommendation": {"recommended": false, "confidence": "UNKNOWN_LEVEL"}}}, "brandedFareInfo": {"fareName": "STANDARD", "cabinClass": "ECONOMY", "features": [{"featureName": "PERSONAL_BAGGAGE", "category": "BAGGAGE", "code": "BK03", "label": "1 personal item", "availability": "INCLUDED"}, {"featureName": "CABIN_BAGGAGE", "category": "BAGGAGE", "code": "BK02", "label": "1 cabin bag", "availability": "INCLUDED"}, {"featureName": "CHECK_BAGGAGE", "category": "BAGGAGE", "code": "BK01", "label": "1 checked bag (50.7 lbs)", "availability": "INCLUDED"}], "nonIncludedFeaturesRequired": false}, "brandedFareOffers": [{"brandedFareInfo": {"fareName": "STANDARD", "cabinClass": "ECONOMY", "features": [{"featureName": "PERSONAL_BAGGAGE", "category": "BAGGAGE", "code": "BK03", "label": "1 personal item", "availability": "INCLUDED"}, {"featureName": "CABIN_BAGGAGE", "category": "BAGGAGE", "code": "BK02", "label": "1 cabin bag", "availability": "INCLUDED"}, {"featureName": "CHECK_BAGGAGE", "category": "BAGGAGE", "code": "BK01", "label": "1 checked bag (50.7 lbs)", "availability": "INCLUDED"}, {"featureName": "CARRY_ON_HAND_BAGGAGE", "availability": "INCLUDED", "category": "BAGGAGE", "code": "0L5"}], "nonIncludedFeaturesRequired": false, "fareTag": "BAGGAGE"}, "ancillaries": {"flexibleTicket": {"airProductReference": "n/a", "travellers": ["1"], "priceBreakdown":