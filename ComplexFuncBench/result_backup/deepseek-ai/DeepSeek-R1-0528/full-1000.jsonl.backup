, "name": "Nature & outdoor", "tagname": "nature-outdoor", "productCount": 229}, {"__typename": "FilterOption", "name": "Entertainment & tickets", "tagname": "entertainment-tickets", "productCount": 178}, {"__typename": "FilterOption", "name": "Food & drinks", "tagname": "food-drinks", "productCount": 75}], "labelFilters": [{"__typename": "FilterOption", "name": "Free cancellation", "tagname": "free_cancellation", "productCount": 2338}], "ufiFilters": [{"__typename": "FilterOption", "name": "Paris", "tagname": "-1456928", "productCount": 3110}, {"__typename": "FilterOption", "name": "Versailles", "tagname": "-1475811", "productCount": 57}, {"__typename": "FilterOption", "name": "Marne-la-Vallee", "tagname": "-1449817", "productCount": 30}, {"__typename": "FilterOption", "name": "Grisy Suisnes", "tagname": "-1430775", "productCount": 1}, {"__typename": "FilterOption", "name": "Rungis", "tagname": "-1463315", "productCount": 1}], "priceFilters": [{"__typename": "FilterOption", "name": "US$0 - US$22", "tagname": "b0", "productCount": 218}, {"__typename": "FilterOption", "name": "US$22 - US$44", "tagname": "b1", "productCount": 248}, {"__typename": "FilterOption", "name": "US$44 - US$83", "tagname": "b2", "productCount": 377}, {"__typename": "FilterOption", "name": "US$83 - US$138", "tagname": "b3", "productCount": 463}, {"__typename": "FilterOption", "name": "US$138+", "tagname": "b4", "productCount": 1989}]}}}]}, {"role": "assistant", "function_call": [{"name": "Get_Attraction_Details", "arguments": {"slug": "prjyfitkuhfz-one-day-admission-to-disneylandr-paris"}}]}, {"role": "observation", "content": [{"status": true, "message": "Success", "data": {"__typename": "AttractionsProduct", "accessibility": ["Transport is wheelchair accessible", "Wheelchair accessible", "Accessible to pushchairs/prams", "Service animals welcome", "Public transport links nearby"], "additionalInfo": "Wheelchair accessible on transport and in the parks. AudioSpot available for visual impairments about certain attractions in the Disney Parks.\r\n\r\nYou can use your 1 Park ticket to enter Walt Disney Studios Park to discover the Marvel Avengers Campus.\r\n\r\nPlease note that no modifications can be made to the admission ticket, including name changes. Please show your ID at the gate entrance.\r\n\r\nYou can present either a printed or mobile ticket.\r\n\r\nPlease note that child tickets are available for children aged 3–11 years.\r\n\r\nIf travelling alone, children aged 0–17 years require written consent (authorisation form) from parents or legal guardians in order to access Disneyland® Park or Walt Disney Studios® Park.\r\n\r\nChildren aged 0–12 years must be accompanied by an adult to access the parks.\r\n\r\nPlease check the guidelines for each ride or attraction for the most up-to-date restrictions. Please note that selected attractions require children to be accompanied by an adult.\r\n\r\nFor safety reasons, certain attractions are subject to restrictions such as height, health and physical conditions. Age restrictions may apply for access to certain facilities.\r\n\r\nSome shows, attractions, locations within Disney® Parks, animations, shops and restaurants are open only in certain seasons and can be closed, modified, delayed or deleted without advance notice.\n\nPlease bring your ticket with you to the attraction.\n\nBe aware that operators may cancel for unforeseen reasons.\n\nYou need to be 18 years or older to book or be accompanied by an adult. ", "applicableTerms": [{"__typename": "TermsConditions", "policyProvider": "Booking.com"}, {"__typename": "TermsConditions", "policyProvider": "Viator"}], "cancellationPolicy": {"__typename": "AttractionsCancellationPolicy", "hasFreeCancellation": true}, "description": "With this admission ticket, you'll have the opportunity to visit one or both Disney® Parks in Paris – Disneyland® Park and Walt Disney Studios® Park. You'll also have the option to hop between both theme parks as many times as you like.\r\n\r\nAt Disneyland® Park, you can explore five themed areas – Main Street U.S.A., Adventureland, Fantasyland, Discoveryland and Frontierland. Your ticket will allow you to hop on rides like Pirates of the Caribbean, Mad Hatters Tea Cups and more. You can even meet your favourite Disney® characters at this park.\r\n\r\nWalt Disney Studios® Park will give you a chance to discover thrilling attractions and entertaining shows from MARVEL, Pixar and the world of Disney. You'll be able to experience some memorable moments from films like Toy Story, Finding Nemo and Ratatouille through various rides at this theme park.", "flags": [{"__typename": "AttractionsProductFlags", "flag": "bestseller", "value": true, "rank": 2}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerInMonth", "value": true, "rank": 1}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerInWeek", "value": true, "rank": 1}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerOnWeekends", "value": true, "rank": 2}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerForAttractions", "value": true, "rank": 1}], "healthSafety": ["Suitable for all fitness levels"], "id": "PRjYfiTKUhFz", "isBookable": true, "labels": [{"__typename": "AttractionsLabel", "text": "Free cancellation", "type": "free_cancellation"}], "name": "Admission to Disneyland® Paris", "notIncluded": ["Hotel pickup and drop-off", "Round-trip transportation to Disneyland® Paris", "Food and drinks", "Skip-the-line on park attractions"], "offers": [{"__typename": "Offer", "availabilityType": "date_time", "id": "OFppSQNSqaX4"}, {"__typename": "Offer", "availabilityType": "date_time", "id": "OFCbcOisHWB0"}, {"__typename": "Offer", "availabilityType": "date_time", "id": "OF8BpbepBnHz"}, {"__typename": "Offer", "availabilityType": "date_time", "id": "OFondy2ME1ox"}, {"__typename": "Offer", "availabilityType": "date_time", "id": "OFQa8uQpuUeL"}], "onSiteRequirements": {"__typename": "OnSiteRequirements"}, "oper