ame": "Entertainment & tickets", "tagname": "entertainment-tickets", "productCount": 76}, {"__typename": "FilterOption", "name": "Food & drinks", "tagname": "food-drinks", "productCount": 31}], "labelFilters": [{"__typename": "FilterOption", "name": "Free cancellation", "tagname": "free_cancellation", "productCount": 1260}], "ufiFilters": [{"__typename": "FilterOption", "name": "Amsterdam", "tagname": "-2140479", "productCount": 1291}, {"__typename": "FilterOption", "name": "Haarlem", "tagname": "-2145280", "productCount": 37}, {"__typename": "FilterOption", "name": "Alkmaar", "tagname": "-2140374", "productCount": 16}, {"__typename": "FilterOption", "name": "Hoorn", "tagname": "-2146647", "productCount": 12}, {"__typename": "FilterOption", "name": "Volendam", "tagname": "-2154955", "productCount": 11}], "priceFilters": [{"__typename": "FilterOption", "name": "US$0 - US$22", "tagname": "b0", "productCount": 226}, {"__typename": "FilterOption", "name": "US$22 - US$44", "tagname": "b1", "productCount": 311}, {"__typename": "FilterOption", "name": "US$44 - US$83", "tagname": "b2", "productCount": 129}, {"__typename": "FilterOption", "name": "US$83 - US$138", "tagname": "b3", "productCount": 116}, {"__typename": "FilterOption", "name": "US$138+", "tagname": "b4", "productCount": 636}]}}}]}, {"role": "assistant", "function_call": [{"name": "Get_Attraction_Details", "arguments": {"slug": "prz8b1w8aysi-van-gogh-museum-tour"}}]}, {"role": "observation", "content": [{"status": true, "message": "Success", "data": {"__typename": "AttractionsProduct", "additionalInfo": "Your ticket allows admission to Van Gogh Museum at the selected time slot.\r\n\r\nChildren aged 0–17 years can enter for free but require a reservation.\r\n\r\nPlease note that tickets can not be refunded after purchase.\n\nPlease bring your ticket with you to the attraction.\n\nBe aware that operators may cancel for unforeseen reasons.\n\nYou need to be 18 years or older to book or be accompanied by an adult. ", "applicableTerms": [{"__typename": "TermsConditions", "policyProvider": "Booking.com"}, {"__typename": "TermsConditions", "policyProvider": "Musement"}], "audioSupportedLanguages": ["English (UK)", "Dutch", "French", "German", "Italian", "Portuguese", "Spanish", "Russian", "Simplified Chinese", "Japanese", "Korean"], "cancellationPolicy": {"__typename": "AttractionsCancellationPolicy", "hasFreeCancellation": false}, "description": "The Van Gogh Museum has the world's largest collection of Vincent Van Gogh's masterpieces. Located in Amsterdam, the museum helps shed light on the artist's life. Here, you will learn more about Van Gogh's emotions, personal ambitions, the myths surrounding the artist and other artwork influenced by him. \r\n\r\nIn addition to some of his early and lesser-known works, you will get a chance to see his most famous paintings including 'Bedroom in Arles', a painting from the Sunflower series and 'Gauguin's Chair'. All these works are chronologically arranged so that you can trace Van Gogh's growth and artistic development.\r\n\r\nAlong with the impressive collection, you will also get to admire the building's architecture which includes a glass entrance on Museumplein.", "flags": [{"__typename": "AttractionsProductFlags", "flag": "bestseller", "value": true, "rank": 4}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerInMonth", "value": true, "rank": 1}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerInWeek", "value": true, "rank": 1}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerOnWeekends", "value": true, "rank": 1}, {"__typename": "AttractionsProductFlags", "flag": "bestsellerForMuseums", "value": true, "rank": 1}], "id": "PRz8B1W8aYsI", "isBookable": true, "name": "Van Gogh Museum Admission", "offers": [{"__typename": "Offer", "availabilityType": "date_time", "id": "OFPpvu272CNI"}, {"__typename": "Offer", "availabilityType": "date_time", "id": "OFFVcHh8Q82l"}], "onSiteRequirements": {"__typename