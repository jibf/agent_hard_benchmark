{
  "num_workers": 32,
  "api_rate_limit": 60,
  "timeout_per_case": 60,
  "batch_size": 50,
  "max_retries": 3,
  "output_dir": "score",
  "backup_interval": 300,
  "memory_limit_gb": 16,
  "target_tasks": [
    "live_multiple",
    "multi_turn_long_context",
    "multi_turn_miss_func",
    "live_irrelevance",
    "multi_turn_miss_param",
    "multi_turn_base",
    "irrelevance",
    "live_simple"
  ],
  "analysis_settings": {
    "include_ground_truth": true,
    "include_multi_turn_context": true,
    "model_specific_formatting": true,
    "enhanced_error_analysis": true
  },
  "server_settings": {
    "enable_progress_monitoring": true,
    "auto_backup": true,
    "graceful_shutdown": true,
    "resource_monitoring": true
  }
}